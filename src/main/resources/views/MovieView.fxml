<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="507.0" prefWidth="344.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mrs.GUI.Controller.MovieViewController">
   <children>
      <TextField fx:id="txtMovieSearch" layoutX="10.0" layoutY="153.0" prefHeight="26.0" prefWidth="315.0" promptText="Search" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="153.0" />
      <TextField fx:id="txtTitle" layoutX="20.0" layoutY="24.0" prefHeight="26.0" prefWidth="306.0" promptText="Movie title" />
      <TextField fx:id="txtYear" layoutX="20.0" layoutY="65.0" prefHeight="25.0" prefWidth="132.0" promptText="Movie year" />
      <Button fx:id="btnClick" layoutX="205.0" layoutY="65.0" mnemonicParsing="false" onAction="#onClick" prefHeight="25.0" prefWidth="121.0" text="Create" />
      <TableView fx:id="tblMovies" layoutX="10.0" layoutY="190.0" prefHeight="303.0" prefWidth="616.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="190.0">
         <columns>
            <TableColumn fx:id="colTitle" maxWidth="500.0" minWidth="200.0" prefWidth="200.0" text="Title" />
            <TableColumn fx:id="colYear" maxWidth="80.0" minWidth="80.0" text="Year" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
